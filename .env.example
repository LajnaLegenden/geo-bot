# Coolify → your app → Environment Variables. (Or a .env for local `docker run`.)
GITHUB_REPO=LajnaLegenden/geo-bot
GITHUB_TOKEN=github_pat_...       # fine-grained PAT, Contents: read/write on this repo
GEO_NCFA=your_geoguessr_ncfa_cookie
SLACK_SINK=workflow              # 'workflow' uses SLACK_WORKFLOW_URL; 'incoming' uses SLACK_WEBHOOK_URL
SLACK_WORKFLOW_URL=
SLACK_WEBHOOK_URL=
