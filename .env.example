# Runtime env (Coolify → Environment Variables, or a .env for local `docker run`).

# REQUIRED. Encrypts stored credentials (GeoGuessr cookies, webhook URLs) at rest.
# Generate once and keep it stable, or all stored secrets become unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GEO_FERNET_KEY=

# REQUIRED. Flask session signing key (stable across restarts, else logins reset):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. SQLite path — the container sets /data/geobot.db; locally defaults to data/geobot.db.
GEO_DB=/data/geobot.db

# Optional. HTTP port (default 8080).
PORT=8080

# REQUIRED for Slack bot credentials, otherwise optional. Public base URL of this app
# (no trailing slash), e.g. https://geo.example.com. Two uses:
#   1. Slack's interactivity request URL is <BASE_URL>/slack/interact — without it,
#      buttons, player linking and DMs do nothing (the app warns about this at boot).
#   2. The "📊 Stats" button link on the leaderboard post; omitted without this or a
#      league public slug, so there's never a dead link.
BASE_URL=
